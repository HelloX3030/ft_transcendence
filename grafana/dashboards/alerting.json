{
  "uid": "cinemates-alerting",
  "title": "Alerting",
  "description": "What is firing, what is about to, and whether the pipeline that delivers it is itself healthy.",
  "tags": [
    "cinemates",
    "alerting"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "refresh": "30s",
