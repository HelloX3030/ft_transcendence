    {
      "type": "stat",
      "title": "Evictions",
      "description": "Keys Redis threw away in the last hour to stay under its cap. The policy is allkeys-lru, so this happens silently \u2014 and every evicted TMDB entry is an upstream call, and a slice of rate budget, paid twice.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "range": true,
          "expr": "increase(redis_evicted_keys_total[1h]) or vector(0)",
          "legendFormat": ""
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
