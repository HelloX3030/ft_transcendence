generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model friends {
  userAId                        Int @map("user_a_id")
  userBId                        Int @map("user_b_id")
  status                         friend_status
  created_at                     DateTime?     @default(dbgenerated("timezone('utc'::text, now())")) @db.Timestamp(6)

  userA users @relation("userA", fields: [userAId], references: [id],  onDelete: NoAction, onUpdate: NoAction)
  userB users @relation("userB", fields: [userBId], references: [id],  onDelete: NoAction, onUpdate: NoAction)

  @@id([userAId, userBId])
}

model movies {
  id         Int    @id @default(autoincrement())
  tmdbId     Int    @unique @map("tmdb_id")
  name       String @db.VarChar(255)

  ratings          ratings[]
  watchlistMovies  watchlist_movies[]
}

model ratings {
  userId      Int @map("user_id")
  movieId     Int @map("movie_id")

  trailerRating reaction_type @map("trailer_rating")
  movieRating   Int @default(0) @db.SmallInt @map("movie_rating")

  createdAt DateTime? @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamp(6)

  movie movies @relation(fields: [movieId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  user  users  @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([userId, movieId])
}

model users {
  id       Int    @id @default(autoincrement())
  username String @unique @db.VarChar(32)
  password String @db.VarChar(512)
  email    String @unique @db.VarChar(255)
  image    String? @db.VarChar(255)

  language language_code
  role     user_role

  createdAt DateTime? @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamp(6)

  friendsA  friends[]   @relation("userA")
  friendsB  friends[]   @relation("userB")

  ratings          ratings[]
  watchlistUsers   watchlist_users[]
}

model watchlist_movies {
  watchlistId Int @map("watchlist_id")
  movieId     Int @map("movie_id")

  movie     movies     @relation(fields: [movieId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  watchlist watchlists @relation(fields: [watchlistId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([watchlistId, movieId])
}

model watchlist_users {
  watchlistId Int @map("watchlist_id")
  userId      Int @map("user_id")

  role watchlist_role

  user       users       @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  watchlist  watchlists  @relation(fields: [watchlistId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([watchlistId, userId])
}

model watchlists {
  id    Int    @id @default(autoincrement())
  name  String @db.VarChar(255)
  image String? @db.VarChar(255)

  createdAt DateTime? @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at") @db.Timestamp(6)

  watchlistMovies watchlist_movies[]
  watchlistUsers  watchlist_users[]
}

enum friend_status {
  pending
  accepted
  blocked
}

enum language_code {
  de
  en
  es
}

enum reaction_type {
  like
  dislike
}

enum user_role {
  admin
  user
}

enum watchlist_role {
  owner
  editor
  viewer
}
