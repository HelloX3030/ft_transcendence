generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model friends {
  userAId    Int           @map("user_a_id")
  userBId    Int           @map("user_b_id")
  initiatorId Int          @map("initiator_id")
  status     friend_status
  createdAt  DateTime      @default(dbgenerated("timezone('utc'::text, now())"))  @map("created_at")

  userA users @relation("userA", fields: [userAId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  userB users @relation("userB", fields: [userBId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  initiator users @relation("initiator", fields: [initiatorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([userAId, userBId])
}

/// Direct messages between two users.
///
/// Keyed by the canonical pair rather than sender/recipient: expressed as
/// sender/recipient a history query is `(sender=A AND recipient=B) OR (sender=B
/// AND recipient=A)`, an OR across two columns that no single index serves.
/// Sorting the ids into `userAId < userBId` makes the conversation one equality
/// prefix, so the index below answers both "latest page" and "page before
/// cursor" as a single range scan with no sort step. Reuses the same idiom as
/// `friends` — see `FriendUtils.getFriendsKey`.
model messages {
  id        Int       @id @default(autoincrement())
  userAId   Int       @map("user_a_id")
  userBId   Int       @map("user_b_id")
  /// One of userAId / userBId. The recipient is derived, not stored.
  senderId  Int       @map("sender_id")
  body      String    @db.VarChar(2000)
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at")

  userA  users @relation("msgUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB  users @relation("msgUserB", fields: [userBId], references: [id], onDelete: Cascade)
  sender users @relation("msgSender", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([userAId, userBId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([userAId, userBId, readAt])
}

/// One row per delivered notification. The row is the source of truth; the
/// socket event is only the fast path, so an offline recipient loses nothing.
model notifications {
  id        Int               @id @default(autoincrement())
  userId    Int               @map("user_id")
  type      notification_type
  actorId   Int?              @map("actor_id")
  entityId  Int?              @map("entity_id")
  /// Values snapshotted at event time, so a later rename cannot rewrite history.
  params    Json              @default("{}")
  readAt    DateTime?         @map("read_at")
  createdAt DateTime          @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at")

  user  users  @relation("notifyRecipient", fields: [userId], references: [id], onDelete: Cascade)
  // SetNull, not Cascade: "alice accepted your request" must survive alice
  // deleting her account. params.actorUsername still renders it.
  actor users? @relation("notifyActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([userId, readAt])
}

/// One row per stored object. Uploads are first-class rows rather than a URL
/// string on the owning record, so access control, deletion and orphan cleanup
/// all have something to hang off.
///
/// Ids are immutable: replacing an avatar inserts a new row rather than
/// rewriting this one, which is what makes `/files/:id` safe to cache forever.
model files {
  id           Int       @id @default(autoincrement())
  ownerId      Int       @map("owner_id")
  /// Object key in MinIO.
  key          String    @unique @db.VarChar(255)
  /// Canonical mimetype, derived from the magic bytes — never from the request.
  mimetype     String    @db.VarChar(64)
  size         Int
  originalName String    @map("original_name") @db.VarChar(255)
  kind         file_kind
  createdAt    DateTime  @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at")

  owner users @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  avatarOf users[] @relation("userAvatar")

  @@index([ownerId, kind])
}

model movies {
  id         Int     @id @default(autoincrement())
  tmdbId     Int     @unique @map("tmdb_id")
  name       String  @db.VarChar(255)
  posterPath String? @map("poster_path") @db.VarChar(255)

  ratings         ratings[]
  watchlistMovies watchlist_movies[]
}

model ratings {
  userId  Int @map("user_id")
  movieId Int @map("movie_id")

  trailerRating reaction_type @map("trailer_rating")
  movieRating   Int           @default(0) @map("movie_rating") @db.SmallInt

  watchTime Int? @map("watch_time") @db.SmallInt

  createdAt DateTime  @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at")

  movie movies @relation(fields: [movieId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user  users  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, movieId])
}

model sessions {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  sessionHash String   @map("session_hash") @db.VarChar(512)
  ipAddress   String   @map("ip_address") @db.VarChar(128)
  userAgent   String   @map("user_agent") @db.VarChar(255)
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at")

  user users @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model users {
  id       Int     @id @default(autoincrement())
  username String  @unique @db.VarChar(32)
  /// Null for accounts created through an external provider, which never had a
  /// local password. Every read site has to handle that before hitting argon2.
  password String? @db.VarChar(512)
  email    String  @unique @db.VarChar(255)
  /// Google's `sub` claim. Unique so two accounts can never claim one identity.
  googleId String? @unique @map("google_id") @db.VarChar(255)
  /// SetNull rather than a second write: deleting the file clears the reference
  /// in one operation, so the two can never diverge.
  avatarFileId Int? @map("avatar_file_id")
  totpSecret String?  @db.VarChar(512) @map("totp_secret")
  totpActive Boolean @default(false) @map("totp_active")
  // Highest TOTP counter already spent. A code is only accepted above this, so
  // a captured one cannot be replayed for the rest of its acceptance window.
  totpLastCounter Int? @map("totp_last_counter")

  language language_code
  role     user_role

  onboardingCompleted Boolean @default(false) @map("onboarding_completed")

  featureVector Float[]   @map("feature_vector")
  featVecUpdatedAt DateTime?  @map("feat_vec_updated_at")

  genreIds    Int[] @map("genre_ids")
  actorIds    Int[] @map("actor_ids")
  directorIds Int[] @map("director_ids")

  createdAt DateTime @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at")

  friendsA friends[] @relation("userA")
  friendsB friends[] @relation("userB")
  initiator friends[] @relation("initiator")

  ratings        ratings[]
  watchlistUsers watchlist_users[]

  notifications      notifications[] @relation("notifyRecipient")
  causedNotifications notifications[] @relation("notifyActor")

  messagesA    messages[] @relation("msgUserA")
  messagesB    messages[] @relation("msgUserB")
  sentMessages messages[] @relation("msgSender")

  sessions sessions[]

  passwordResets password_resets[]

  files      files[]
  avatarFile files? @relation("userAvatar", fields: [avatarFileId], references: [id], onDelete: SetNull)
}

/// One row per outstanding password-reset request. The row is what makes a reset
/// link single-use and revocable; a self-contained JWT could be neither — it
/// stays valid for its whole TTL even after the password has already changed.
model password_resets {
  id     Int @id @default(autoincrement())
  userId Int @map("user_id")

  /// SHA-256 of the token that was mailed, not argon2, and deliberately so.
  /// argon2 hashes are salted, so `WHERE tokenHash = ?` cannot find the row —
  /// the alternative is scanning every outstanding row and verifying each, which
  /// is O(rows) argon2 calls on an unauthenticated endpoint: a free
  /// denial-of-service. `sessions` can afford argon2 because the refresh JWT
  /// carries its `sessionId`; a reset link carries only the token. A slow KDF
  /// protects low-entropy secrets, and this is 32 bytes from randomBytes, so
  /// SHA-256 gives an indexed lookup and loses nothing that matters here.
  tokenHash String @unique @map("token_hash") @db.VarChar(64)

  expiresAt DateTime  @map("expires_at")
  /// Set in the same statement that consumes the token, which is what makes a
  /// link single-use.
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at")

  user users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model watchlist_movies {
  watchlistId Int @map("watchlist_id")
  movieId     Int @map("movie_id")

  movie     movies     @relation(fields: [movieId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  watchlist watchlists @relation(fields: [watchlistId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([watchlistId, movieId])
}

model watchlist_users {
  watchlistId Int @map("watchlist_id")
  userId      Int @map("user_id")

  role watchlist_role

  user      users      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  watchlist watchlists @relation(fields: [watchlistId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([watchlistId, userId])
}

model watchlists {
  id    Int     @id @default(autoincrement())
  name  String  @db.VarChar(255)

  createdAt DateTime @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at")

  watchlistMovies watchlist_movies[]
  watchlistUsers  watchlist_users[]
}

/// Only `avatar` exists today. The enum is here so a second kind is additive
/// rather than a redesign — authorization in FilesService branches on it.
enum file_kind {
  avatar
}

enum friend_status {
  pending
  accepted
}

enum notification_type {
  friend_request_created
  friend_request_accepted
  friend_request_declined
  friend_request_cancelled
  friend_removed
  watchlist_user_added
  watchlist_user_removed
  watchlist_movie_added
  watchlist_movie_removed
  watchlist_deleted
}

enum language_code {
  de
  en
  es
}

enum reaction_type {
  like
  dislike
}

enum user_role {
  admin
  user
}

enum watchlist_role {
  editor
  viewer
}
