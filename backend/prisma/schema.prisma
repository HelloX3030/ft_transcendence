generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model friends {
  userAId    Int           @map("user_a_id")
  userBId    Int           @map("user_b_id")
  initiatorId Int          @map("initiator_id")
  status     friend_status
  createdAt  DateTime      @default(dbgenerated("timezone('utc'::text, now())"))  @map("created_at")

  userA users @relation("userA", fields: [userAId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  userB users @relation("userB", fields: [userBId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  initiator users @relation("initiator", fields: [initiatorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([userAId, userBId])
}

model movies {
  id     Int    @id @default(autoincrement())
  tmdbId Int    @unique @map("tmdb_id")
  name   String @db.VarChar(255)

  ratings         ratings[]
  watchlistMovies watchlist_movies[]
}

model ratings {
  userId  Int @map("user_id")
  movieId Int @map("movie_id")

  trailerRating reaction_type @map("trailer_rating")
  movieRating   Int           @default(0) @map("movie_rating") @db.SmallInt

  watchTime Int? @map("watch_time") @db.SmallInt

  createdAt DateTime  @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at")

  movie movies @relation(fields: [movieId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user  users  @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([userId, movieId])
}

model sessions {
  id          Int      @id @default(autoincrement())
  userId      Int      @map("user_id")
  sessionHash String   @map("session_hash") @db.VarChar(512)
  ipAddress   String   @map("ip_address") @db.VarChar(128)
  userAgent   String   @map("user_agent") @db.VarChar(255)
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at")

  user users @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model users {
  id       Int     @id @default(autoincrement())
  username String  @unique @db.VarChar(32)
  password String  @db.VarChar(512)
  email    String  @unique @db.VarChar(255)
  image    String? @db.VarChar(255)
  totpSecret String?  @db.VarChar(512) @map("totp_secret")
  totpActive Boolean @map("totp_active")

  language language_code
  role     user_role

  onboardingCompleted Boolean @default(false) @map("onboarding_completed")

  featureVector Float[]   @map("feature_vector")
  featVecUpdatedAt DateTime?  @map("feat_vec_updated_at")

  genreIds    Int[] @map("genre_ids")
  actorIds    Int[] @map("actor_ids")
  directorIds Int[] @map("director_ids")

  createdAt DateTime @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at")

  friendsA friends[] @relation("userA")
  friendsB friends[] @relation("userB")
  initiator friends[] @relation("initiator")

  ratings        ratings[]
  watchlistUsers watchlist_users[]

  sessions sessions[]
}

model watchlist_movies {
  watchlistId Int @map("watchlist_id")
  movieId     Int @map("movie_id")

  movie     movies     @relation(fields: [movieId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  watchlist watchlists @relation(fields: [watchlistId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([watchlistId, movieId])
}

model watchlist_users {
  watchlistId Int @map("watchlist_id")
  userId      Int @map("user_id")

  role watchlist_role

  user      users      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  watchlist watchlists @relation(fields: [watchlistId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([watchlistId, userId])
}

model watchlists {
  id    Int     @id @default(autoincrement())
  name  String  @db.VarChar(255)
  image String? @db.VarChar(255)

  createdAt DateTime @default(dbgenerated("timezone('utc'::text, now())")) @map("created_at")

  watchlistMovies watchlist_movies[]
  watchlistUsers  watchlist_users[]
}

enum friend_status {
  pending
  accepted
}

enum language_code {
  de
  en
  es
}

enum reaction_type {
  like
  dislike
}

enum user_role {
  admin
  user
}

enum watchlist_role {
  editor
  viewer
}
