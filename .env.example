# --- Database ---
DB_USER=cinemates
DB_PASSWORD=changeme
DB_NAME=cinemates
DB_TEST_NAME=cinemates_test

# --- pgAdmin ---
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=changeme

# --- Services ---
# Relative on purpose: Caddy serves the app and proxies /api/* on one origin,
# so every call is same-origin and resolves against whatever host the browser
# used — localhost, a LAN address, or a real domain later.
BACKEND_URL=/api
# Every origin the browser may reach this app at. The first is canonical and is
# what the backend puts into links that leave the request (password-reset mail).
# All of them are accepted by the CORS and socket.io origin checks. Add the LAN
# origin here when APP_HOST is set to a LAN address, or the notification socket
# is refused and chat, presence and notifications go dead on that device.
APP_ORIGINS=https://localhost:8443,https://127.0.0.1:8443

# An additional host the browser may use to reach the stack, on top of localhost
# and 127.0.0.1 — set it to this machine's LAN address to open the app from a
# phone or a second laptop on the same network. Find it with:
#
#   ip -4 route get 1.1.1.1 | awk '{print $7; exit}'      # -> e.g. 10.13.6.3
#
# then put that address here AND as an origin in APP_ORIGINS above. Both keep
# working; this adds a name, it does not replace one. Do not leave it blank: an
# empty value turns the site into a catch-all (see the comment in caddy/Caddyfile).
APP_HOST=127.0.0.1

# --- MinIO (object storage) ---
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=changeme
MINIO_SECRET_KEY=changeme
MINIO_BUCKET=avatars

JWT_ACCESS_SECRET="8b9b7c598a4b65a0a34d942d1a26a3c3a8ca1999336159d5368273e8b309c9285ca34e1f708ce41a1cdba4b1f6251bdc443373bcb61742cc3e01780197ce536d"
JWT_REFRESH_SECRET="a1573d0fd1f6e22995b7c32c3c415e3932eb8d46e001c969c8982f1792afc3f294777c905adfaeaa3492ef5635d665c453d1bc99534f52549e8a0513b4bc099a"

# --- Sessions ---
# The values below are the production ones and can be left alone. They are
# configurable because none of them can be watched expire by hand at these
# lengths, which is why they went unverified. To test expiry, rotation and the
# absolute cap in about a minute each, swap in:
#
#   ACCESS_TTL_SECONDS=30
#   REFRESH_TTL_SECONDS=60
#   SESSION_ABSOLUTE_TTL_SECONDS=180
#   REFRESH_GRACE_SECONDS=2
#
# Access-token lifetime; the frontend refreshes when it runs out.
ACCESS_TTL_SECONDS=900
# Idle timeout: pushed out on every refresh.
REFRESH_TTL_SECONDS=1296000
# Hard cap from session creation, no matter how actively it is used.
SESSION_ABSOLUTE_TTL_SECONDS=2592000
# How long the pre-rotation refresh key is still accepted, so two tabs
# refreshing at once do not log each other out.
REFRESH_GRACE_SECONDS=30

# --- MFA ---
# To create a new key, run the following command: openssl rand -hex 32
MFA_KEY="a3f1c9d4b2e8f0c1d3a4b5c6e7f8091a2b3c4d5e6f7081920a1b2c3d4e5f6071"

# --- Monitoring ---
# MinIO already speaks Prometheus; its metrics endpoint just requires a bearer
# token, which MinIO derives from the credentials above. Regenerate it whenever
# MINIO_ACCESS_KEY or MINIO_SECRET_KEY changes — the old one stops working and
# the scrape starts answering 403:
#
#   docker run --rm --network ft_transcendence_web \
#     -e "MC_HOST_m=http://$MINIO_ACCESS_KEY:$MINIO_SECRET_KEY@minio:9000" \
#     minio/mc admin prometheus generate m
#
# Used rather than MINIO_PROMETHEUS_AUTH_TYPE=public, which would open the
# endpoint to everything else on the Docker network — the same exposure the
# backend's METRICS_TOKEN exists to prevent.
MINIO_METRICS_TOKEN=run_the_command_above_to_generate_one

# Shared secret Prometheus presents as `Authorization: Bearer <token>` when it
# scrapes the backend's GET /metrics. To create a new one, run:
#
#   openssl rand -hex 32
#
# Required, so the backend refuses to boot without it rather than serving the
# endpoint unauthenticated. It is the second of two layers: Caddy already
# answers 404 for /api/metrics so no browser can reach it, and this is what
# stops everything else already on the Docker network — frontend, mailpit,
# pgadmin, minio — from reading the metrics by name.
METRICS_TOKEN="7f3b9e2a5c1d8406b3e5f7a9c2d4e6081a3b5c7d9e0f2143a5b7c9d1e3f50617"

# Grafana's admin login, reached at https://localhost:8443/grafana — it has no
# published port, so this route through Caddy is the only way in.
#
# The default admin/admin is the most common way a Grafana ends up readable by
# anyone who finds it, so there is no fallback in docker-compose.yml: an unset
# value here leaves the container without a password and it will not start
# usefully. Anonymous access and self sign-up are both disabled there too.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme

# --- TMDB ---
TMDB_API_KEY=your_tmdb_bearer_token_here
# Self-imposed ceiling on outbound TMDB traffic. TMDB's own limit is a soft
# ~40 requests/second per IP that they say could change at any time, so we sit
# at roughly half of it. Here rather than in code so it can be turned down
# without a rebuild if TMDB starts answering 429.
#
# Applied per process: the backend and the recommender each pace themselves to
# this number, so what TMDB sees from one host is the sum of the two. Halve it
# if both are busy at once, rather than assuming it is a shared pool.
TMDB_RATE_LIMIT=20
TMDB_RATE_WINDOW_SECONDS=1

# --- Recommendation service ---
# Internal only — the service has no published port (see README).
RECOMMENDER_URL=http://recommender:8000
# Shared secret for POST /retrain, sent as an X-Retrain-Secret header. The
# nightly SVD refit is the only thing it guards, but an open one lets anyone
# burn CPU on demand. Leave it unset and the endpoint refuses every request
# rather than running unauthenticated. Generate one with:
#
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
RETRAIN_SECRET=replace_me_with_a_generated_secret

# --- Onboarding preference extraction ---
# How many derived ids are handed to the recommendation service, as the cold-start
# seed for a user with no swipes yet. Actors and directors were pinned to 0 while
# the recommender AND-joined every dimension into one Discover query, which no film
# satisfied; it now issues one query per dimension, so they widen the candidate pool
# instead of emptying it. The derivation always runs in full and applies its own
# quality filters (top-5 billed cast only, and a person must recur across picks) —
# these numbers only truncate the result.
ONBOARDING_MAX_GENRES=5
ONBOARDING_MAX_ACTORS=4
ONBOARDING_MAX_DIRECTORS=3

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Google Sign-In (optional) ---
# Leave these empty to run without Google login: the stack boots normally and
# the "Continue with Google" button is hidden. See the README for the Google
# Cloud setup. GOOGLE_CALLBACK_URL must match the Authorized redirect URI in
# the console character for character.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://localhost:8443/api/v1/auth/google/callback
# Set to "true" only once the three values above are filled in — this is what
# reveals the button in the frontend.
GOOGLE_ENABLED=false

# --- Mail (Mailpit) ---
# Mail is captured, not delivered: open http://localhost:8025 to read it.
# Pointing these at a real SMTP provider is the only change needed to deliver.
SMTP_HOST=mailpit
SMTP_PORT=1025
MAIL_FROM="CineMates <no-reply@cinemates.local>"

# --- Logging (ELK) ----------------------------------------------------------
# Elasticsearch runs with authentication enabled, so every client logs in —
# Logstash, Kibana, the setup containers and anyone with a shell. This is the
# superuser password, used by the setup scripts and by Logstash's writer.
#
# Required: there is no fallback in docker-compose.yml, so an unset value leaves
# Elasticsearch without a password and it will not start usefully.
ELASTIC_PASSWORD=changeme

# Kibana does not connect as the superuser above. It uses the built-in
# kibana_system account, which can manage Kibana's own indices and nothing else,
# so a compromised Kibana container cannot read or delete arbitrary data. The
# account exists from the start but has no usable password until elk_setup sets
# it to this value on first boot.
#
# Change this and the old password stays in place until the setup container runs
# again — `docker compose up -d elk_setup` re-applies it.
KIBANA_SYSTEM_PASSWORD=changeme

# Encrypts Kibana's session cookies and any saved object holding a credential.
# Must be at least 32 characters. Kibana invents a random one at boot when this
# is unset, which silently logs everyone out and orphans saved queries on every
# restart — the failure looks like Kibana forgetting things rather than a
# missing setting, so it is worth setting properly:
#
#   openssl rand -hex 32
KIBANA_ENCRYPTION_KEY=change_me_to_at_least_thirty_two_characters
