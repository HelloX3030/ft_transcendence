# A browser asking for a bare IP address sends no SNI — an IP literal is not a
# legal SNI value — so Caddy has nothing to select a certificate on and the
# handshake fails outright rather than merely warning. This names the
# certificate to fall back to, which has to be APP_HOST: it is the only name
# here that can be an IP address.
#
# {$VAR:default} substitutes the default only when the variable is *unset*. A
# .env that predates APP_HOST leaves it set-and-empty instead, and this line is
# then what makes Caddy refuse to start, naming itself in the error — which is
# the outcome to want, because the same empty value would otherwise turn the
# site address below into a bare :8443 catch-all that quietly serves every Host.
{
	default_sni {$APP_HOST:127.0.0.1}
}

# Ports 443 and 80 are deliberately not used: the school machines run rootless
# Docker, which refuses to publish anything below 1024, so a privileged port
# makes `docker compose up` fail outright. 8443/8080 need no host configuration
# and work the same on a rootful daemon.

# Single origin for the whole application. Everything the browser talks to is
# behind this one host:port, so the self-signed certificate is accepted once —
# under a cert-per-service layout the API calls, being issued by JavaScript
# rather than navigation, would just be blocked silently.
# A site address is a guest list Caddy checks the request's Host header against,
# not an address it binds — so reaching the stack under a second name means
# listing that name here. APP_HOST adds one; it does not replace the loopback
# names, and setting it to a duplicate is harmless (Caddy dedupes). An empty
# APP_HOST would make this a bare :8443 catch-all; see the global block above
# for why that cannot get past startup.
localhost:8443, {$APP_HOST:127.0.0.1}:8443 {
	# Caddy generates and manages its own CA and leaf certificate. No openssl
	# init script, no generated files to gitignore, and nothing to install on
	# the host — mkcert would need admin rights and would not survive a
	# reimaged school machine anyway. One certificate per name, selected by
	# SNI; see default_sni in the global options above for the bare-IP case.
	tls internal

	# Everything backend-side lives under one prefix, which is stripped:
	#   /api/v1/users/me  ->  backend /v1/users/me
	#   /api/docs         ->  backend /docs   (Swagger, mounted in main.ts)
	#   /api/socket.io/   ->  backend /socket.io/
	handle_path /api/* {
		# Prometheus scrapes the backend directly on the Docker network at
		# http://backend:3000/metrics, so a real scrape never passes through
		# Caddy. This path exists only because /api/* is proxied wholesale, and
		# a reachable /metrics hands every visitor the route table, the traffic
		# volumes and the login-failure rate. 404 rather than 403: a 403 would
		# confirm there is something here to find.
		#
		# Inside a `route`, and inside this block rather than beside it, because
		# both placements are about evaluation order: `handle_path` is terminal
		# and Caddy sorts it ahead of a sibling `respond`, so a matcher written
		# next to it never runs. `route` then keeps these two in the order
		# written instead of the standard directive order. Note the prefix is
		# already stripped at this point, so the path to match is /metrics.
		route {
			@metrics path /metrics /metrics/
			respond @metrics 404

			reverse_proxy backend:3000
		}
	}

	# Everything else: the Vue app, including Vite's HMR websocket. Caddy
	# detects and proxies websocket upgrades on its own — no Upgrade/Connection
	# header plumbing, which is the whole reason this is Caddy and not nginx.
	handle {
		reverse_proxy frontend:5173
	}
}

# Caddy's automatic HTTP->HTTPS redirect is not usable here: it builds the
# target from the site's hostname and omits the port whenever that port is the
# configured HTTPS one, so it would send the browser to https://localhost —
# port 443, where nothing is listening. Spell the redirect out instead.
# {host} rather than a literal: the browser is sent back to whichever name it
# used, so this needs no second copy of the host list.
http://localhost:8080, http://{$APP_HOST:127.0.0.1}:8080 {
	redir https://{host}:8443{uri} permanent
}
