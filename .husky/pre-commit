#!/bin/sh
# lint-staged runs ESLint 10, which requires Node >= 20.12.
# We run it inside Docker (node:22-slim) so the hook works regardless of host Node version.
# First run pulls node:22-slim (~230 MB); subsequent commits use the cached image.
# If Docker is not running, commits proceed unverified — CI on Node 22 is the fallback gate.

REPO_ROOT=$(git rev-parse --show-toplevel)

if ! docker info >/dev/null 2>&1; then
  echo "pre-commit: Docker not running — skipping lint-staged (CI on Node 22 will verify)"
  exit 0
fi

# git refuses to operate in directories owned by a different user (Docker runs as root).
# Marking /app as safe lets lint-staged call git diff --cached to find staged files.
docker run --rm \
  -v "$REPO_ROOT:/app" \
  -w /app \
  node:22 \
  sh -c "git config --global --add safe.directory /app && cd /app/frontend && npx lint-staged && cd /app/backend && npx lint-staged"
